# ---------------------------------------------------------------------------
# Tagid – environment variables
# Copy this file to ".env.local" and fill in real values.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon/public key (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key (server-only, used for seeding/admin tasks)
# NEVER expose this in client code. (Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed app. Used when generating the URLs that are
# written onto physical NFC tags, e.g. https://tagid.example.com/t/<code>
NEXT_PUBLIC_BASE_URL=http://localhost:3000
